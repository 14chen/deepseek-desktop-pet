# Dependencies and build output
node_modules/
pnpm-lock.yaml
package-lock.json
yarn.lock

# Local scratch: by-hand screenshots, crop experiments, temporary probes
.tmp/
.seg/
*.log

# Python bytecode from the build helpers
__pycache__/
*.pyc

# The supplied source artwork is deliberately committed: the generated assets
# are derived from it, so keeping it makes `npm run build:assets` reproducible
# from a clone. Delete it and drop in your own to replace the mascot.
# pet-source.png
# pet-source.jpg

